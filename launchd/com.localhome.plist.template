<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template — do not edit the rendered copy by hand.
  `just install` substitutes the @PLACEHOLDER@ tokens and writes
  launchd/<label>.local.plist (gitignored), then loads it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL@</string>

    <key>ProgramArguments</key>
    <array>
        <string>@BUN@</string>
        <string>run</string>
        <string>@REPO@/src/index.ts</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/localhome.log</string>

    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/localhome.error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>@PATH@</string>
        <key>NAME</key>
        <string>@NAME@</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>LC_ALL</key>
        <string>en_US.UTF-8</string>
    </dict>
</dict>
</plist>
